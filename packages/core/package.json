{
  "name": "enflasyon-core",
  "version": "1.0.1",
  "description": "Harcama sepetinden ki\u015fisel enflasyon hesaplayan, s\u0131f\u0131r ba\u011f\u0131ml\u0131l\u0131kl\u0131 TypeScript k\u00fct\u00fcphanesi",
  "keywords": [
    "enflasyon",
    "inflation",
    "cpi",
    "t\u00fcfe",
    "laspeyres"
  ],
  "license": "MIT",
  "author": "Emircan Bakar",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/emircanbakar/enflasyon.git",
    "directory": "packages/core"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint:package": "publint --strict && attw --pack .",
    "size": "size-limit",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {},
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@size-limit/preset-small-lib": "^14.2.0",
    "@vitest/coverage-v8": "^4.1.12",
    "fast-check": "^4.10.2",
    "publint": "^0.3.25",
    "size-limit": "^14.2.0",
    "tsup": "^9.0.0",
    "typescript": "~6.0.3",
    "vitest": "^4.1.12"
  }
}
